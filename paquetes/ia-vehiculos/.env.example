# Copiar a .env y completar. .env no se sube al repositorio.

# --- MercadoExterno: destino ---
# Desarrollo: la base local del contenedor. Producción: 10.10.60.6 con el usuario de grp_mercado_registro.
MERCADO_EXTERNO_HOST=postgres
MERCADO_EXTERNO_PORT=5432
MERCADO_EXTERNO_DB=mercado_externo
MERCADO_EXTERNO_USER=postgres
MERCADO_EXTERNO_PASSWORD=postgres

# --- AutoCare (solo lectura), para la referencia real en la base local ---
AUTOCARE_HOST=
AUTOCARE_PORT=5432
AUTOCARE_DB=autocare_global
AUTOCARE_USER=
AUTOCARE_PASSWORD=

