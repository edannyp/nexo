# Copiar a .env y completar. .env no se sube al repositorio.

# --- Consolidación: destino de la carga ---
# Desarrollo: la base local del contenedor. Producción: 10.10.60.6, base consolidacion_articulos, con el usuario de grp_consolidacion_carga.
CONSOLIDACION_HOST=postgres
CONSOLIDACION_PORT=5432
CONSOLIDACION_DB=articulos_consolidacion
CONSOLIDACION_USER=postgres
CONSOLIDACION_PASSWORD=postgres

# --- Fuentes (solo lectura) ---
DIAGRAMS_HOST=
DIAGRAMS_PORT=5432
DIAGRAMS_DB=db_diagrams
DIAGRAMS_USER=
DIAGRAMS_PASSWORD=

AUTOCARE_HOST=
AUTOCARE_PORT=5432
AUTOCARE_DB=autocare_global
AUTOCARE_USER=
AUTOCARE_PASSWORD=

# --- MercadoExterno: registrar vehículos que no están en AutoCare (regla 10) ---
MERCADO_EXTERNO_HOST=postgres
MERCADO_EXTERNO_PORT=5432
MERCADO_EXTERNO_DB=mercado_externo
MERCADO_EXTERNO_USER=postgres
MERCADO_EXTERNO_PASSWORD=postgres

# --- MinIO: imágenes de diagramas (bucket rlt-diagramas), solo lectura ---
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
