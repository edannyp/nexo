# Copiar a .env y completar. .env no se sube al repositorio.

# --- Nexo (usuario agente_revision_catalogo) ---
# Desarrollo: la base local (base-local/levantar.sh crea el usuario con clave "agente").
# Producción: NEXO_HOST=10.10.60.6 y la contraseña que entregue el equipo de Nexo.
NEXO_HOST=postgres
NEXO_PORT=5432
NEXO_DB=nexo
NEXO_USER=agente_revision_catalogo
NEXO_PASSWORD=agente

# --- Consolidación (solo lectura) ---
# Desarrollo: la base local. Producción: 10.20.20.6 con un usuario de grp_app_lectura.
CONSOLIDACION_HOST=postgres
CONSOLIDACION_PORT=5432
CONSOLIDACION_DB=articulos_consolidacion
CONSOLIDACION_USER=postgres
CONSOLIDACION_PASSWORD=postgres

# --- Modelo de IA que use el agente ---
ANTHROPIC_API_KEY=

# Solo para las bases locales (crear y verificar)
NEXO_LOCAL_ADMIN=host=postgres dbname=nexo user=postgres password=postgres
