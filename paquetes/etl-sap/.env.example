# Copiar a .env y completar. .env no se sube al repositorio.

# --- SAP Business One / HANA (solo lectura) ---
SAP_HANA_HOST=
SAP_HANA_PORT=30015
SAP_HANA_USER=
SAP_HANA_PASSWORD=
SAP_HANA_SCHEMA=
SAP_HANA_ENCRYPT=true
SAP_HANA_SSL_VALIDATE=false

# --- Nexo: destino del ETL (usuario etl_entrada) ---
# Desarrollo: la base local del contenedor (base-local/levantar.sh crea etl_entrada con clave "etl").
# Producción: NEXO_HOST=10.10.60.6 y la contraseña que entregue el equipo de Nexo.
NEXO_HOST=postgres
NEXO_PORT=5432
NEXO_DB=nexo
NEXO_USER=etl_entrada
NEXO_PASSWORD=etl

# Solo para la base local (crear y verificar)
NEXO_LOCAL_ADMIN=host=postgres dbname=nexo user=postgres password=postgres
