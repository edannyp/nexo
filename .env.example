# Copiar a .env y completar. .env está en .gitignore: nunca subir credenciales.

# --- Nexo (local en el DevContainer) ---
NEXO_HOST=postgres
NEXO_PORT=5432
NEXO_DB=nexo
NEXO_USER=postgres
NEXO_PASSWORD=postgres

# --- AutoCare (Postgres, solo lectura) ---
# La API de Nexo los usa para el selector de vehículos (pestaña Aplicaciones); sin ellos, ese selector responde 503.
AUTOCARE_HOST=
AUTOCARE_PORT=5432
AUTOCARE_DB=
AUTOCARE_USER=
AUTOCARE_PASSWORD=
AUTOCARE_SSLMODE=prefer

# --- MercadoExterno (Postgres) ---
# La API registra aquí los vehículos que no están en AutoCare (usuario con grp_mercado_registro).
MERCADO_EXTERNO_HOST=
MERCADO_EXTERNO_PORT=5432
MERCADO_EXTERNO_DB=
MERCADO_EXTERNO_USER=
MERCADO_EXTERNO_PASSWORD=

# --- Consolidación (Postgres) ---
# La API de Nexo la lee para el emparejamiento (usuario con app_lectura); sin ella, no hay candidatos ni búsqueda.
CONSOLIDACION_HOST=
CONSOLIDACION_PORT=5432
CONSOLIDACION_DB=
CONSOLIDACION_USER=
CONSOLIDACION_PASSWORD=

# --- SAP Business One / HANA (solo lectura, exploración) ---
SAP_HANA_HOST=
SAP_HANA_PORT=30015
SAP_HANA_USER=
SAP_HANA_PASSWORD=
SAP_HANA_SCHEMA=
SAP_HANA_ENCRYPT=true
SAP_HANA_SSL_VALIDATE=false

# --- MinIO (fotos de artículos, S3) ---
# Endpoint del API S3 (no la consola web). Con o sin esquema: minio-api.ejemplo.com o https://host:9000
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=true

# --- ClickHouse (volumen de venta / parque vehicular) ---
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default

# --- APP ---
REDIS_URL=redis://redis:6379/0   # sesiones (tokens aleatorios; no requieren secreto de firma)
# Opcionales (ADR 0015): horas sin actividad hasta que vence la sesión, intentos antes del bloqueo y su duración
# NEXO_HORAS_SESION=8
# NEXO_INTENTOS_MAXIMOS=5
# NEXO_MINUTOS_BLOQUEO=15
