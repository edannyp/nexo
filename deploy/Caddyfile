# NEXO_SITIO: dirección del sitio. Por defecto :80 (HTTP en la red interna).
# Con un nombre interno (p. ej. nexo.empresa.local) y "tls internal" Caddy sirve HTTPS con su propia CA.
{$NEXO_SITIO::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		@recursos path /assets/*
		header @recursos Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
