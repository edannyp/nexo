{
  "openapi": "3.1.0",
  "info": {
    "title": "Nexo API",
    "description": "Puente de gobernanza del artículo entre SAP, AutoCare y el catálogo maestro.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/salud": {
      "get": {
        "tags": [
          "salud"
        ],
        "summary": "El proceso responde",
        "operationId": "obtener_salud",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Viva"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/salud/lista": {
      "get": {
        "tags": [
          "salud"
        ],
        "summary": "La base responde y está migrada",
        "operationId": "obtener_salud_lista",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lista"
                }
              }
            }
          },
          "503": {
            "description": "Base no disponible"
          }
        }
      }
    },
    "/api/v1/sesion": {
      "get": {
        "tags": [
          "sesion"
        ],
        "summary": "Sesión actual",
        "operationId": "obtener_sesion",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionInfo"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión"
          }
        }
      },
      "post": {
        "tags": [
          "sesion"
        ],
        "summary": "Iniciar sesión",
        "operationId": "iniciar_sesion",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credenciales"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionInfo"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales incorrectas"
          },
          "429": {
            "description": "Cuenta bloqueada temporalmente"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "sesion"
        ],
        "summary": "Cerrar sesión",
        "operationId": "cerrar_sesion",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/v1/sesion/password": {
      "post": {
        "tags": [
          "sesion"
        ],
        "summary": "Cambiar la contraseña propia",
        "operationId": "cambiar_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CambioPassword"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionInfo"
                }
              }
            }
          },
          "422": {
            "description": "La nueva contraseña no cumple la política"
          }
        }
      }
    },
    "/api/v1/usuarios": {
      "get": {
        "tags": [
          "usuarios"
        ],
        "summary": "Listar usuarios",
        "operationId": "listar_usuarios",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UsuarioAdmin"
                  },
                  "type": "array",
                  "title": "Response Listar Usuarios"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "usuarios"
        ],
        "summary": "Dar de alta un usuario con contraseña temporal",
        "operationId": "crear_usuario",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NuevoUsuario"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioCreado"
                }
              }
            }
          },
          "409": {
            "description": "El usuario ya existe"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/usuarios/{usuario_id}": {
      "patch": {
        "tags": [
          "usuarios"
        ],
        "summary": "Cambiar datos, roles, permisos o estado",
        "operationId": "modificar_usuario",
        "parameters": [
          {
            "name": "usuario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Usuario Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CambiosUsuario"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioAdmin"
                }
              }
            }
          },
          "404": {
            "description": "No existe"
          },
          "409": {
            "description": "Dejaría la APP sin administrador propio"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/usuarios/{usuario_id}/restablecer": {
      "post": {
        "tags": [
          "usuarios"
        ],
        "summary": "Nueva contraseña temporal (cierra sus sesiones)",
        "operationId": "restablecer_password",
        "parameters": [
          {
            "name": "usuario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Usuario Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordTemporal"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/usuarios/{usuario_id}/desbloquear": {
      "post": {
        "tags": [
          "usuarios"
        ],
        "summary": "Quitar el bloqueo por intentos fallidos",
        "operationId": "desbloquear_usuario",
        "parameters": [
          {
            "name": "usuario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Usuario Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/usuarios/{usuario_id}/sesiones": {
      "delete": {
        "tags": [
          "usuarios"
        ],
        "summary": "Cerrar todas las sesiones del usuario",
        "operationId": "cerrar_sesiones_usuario",
        "parameters": [
          {
            "name": "usuario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Usuario Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/preferencias": {
      "get": {
        "tags": [
          "preferencias"
        ],
        "summary": "Preferencias del usuario (por defecto Radiadores · Importados)",
        "operationId": "obtener_preferencias",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferencias"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "preferencias"
        ],
        "summary": "Guardar preferencias",
        "operationId": "guardar_preferencias",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Preferencias"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferencias"
                }
              }
            }
          },
          "422": {
            "description": "Categoría inexistente"
          }
        }
      }
    },
    "/api/v1/categorias": {
      "get": {
        "tags": [
          "catalogos"
        ],
        "summary": "Categorías en alcance con artículos activos por línea",
        "operationId": "listar_categorias",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Categoria"
                  },
                  "type": "array",
                  "title": "Response Listar Categorias"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/panorama": {
      "get": {
        "tags": [
          "panorama"
        ],
        "summary": "Panorama del tipo de artículo (filtro global)",
        "operationId": "obtener_panorama",
        "parameters": [
          {
            "name": "cat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{2}$",
              "description": "Código SAP de la categoría",
              "default": "25",
              "title": "Cat"
            },
            "description": "Código SAP de la categoría"
          },
          {
            "name": "linea",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Linea",
              "description": "Línea",
              "default": "IMPORTADO"
            },
            "description": "Línea"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Panorama"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hallazgos-sap": {
      "get": {
        "tags": [
          "calidad-sap"
        ],
        "summary": "Hallazgos abiertos del tipo de artículo, agrupados",
        "operationId": "listar_hallazgos_sap",
        "parameters": [
          {
            "name": "cat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{2}$",
              "description": "Código SAP de la categoría",
              "default": "25",
              "title": "Cat"
            },
            "description": "Código SAP de la categoría"
          },
          {
            "name": "linea",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Linea",
              "description": "Línea",
              "default": "IMPORTADO"
            },
            "description": "Línea"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HallazgosSap"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hallazgos-sap/csv": {
      "get": {
        "tags": [
          "calidad-sap"
        ],
        "summary": "Hallazgos abiertos en CSV (se abre en Excel)",
        "operationId": "exportar_hallazgos_sap",
        "parameters": [
          {
            "name": "cat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{2}$",
              "description": "Código SAP de la categoría",
              "default": "25",
              "title": "Cat"
            },
            "description": "Código SAP de la categoría"
          },
          {
            "name": "linea",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Linea",
              "description": "Línea",
              "default": "IMPORTADO"
            },
            "description": "Línea"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/csv": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ventas": {
      "get": {
        "tags": [
          "ventas"
        ],
        "summary": "Análisis de ventas del tipo de artículo (requiere permiso)",
        "operationId": "analizar_ventas",
        "parameters": [
          {
            "name": "cat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{2}$",
              "description": "Código SAP de la categoría",
              "default": "25",
              "title": "Cat"
            },
            "description": "Código SAP de la categoría"
          },
          {
            "name": "linea",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Linea",
              "description": "Línea",
              "default": "IMPORTADO"
            },
            "description": "Línea"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalisisVentas"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalisisVentas": {
        "properties": {
          "meses": {
            "type": "integer",
            "title": "Meses"
          },
          "actualizado_en": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actualizado En"
          },
          "serie": {
            "items": {
              "$ref": "#/components/schemas/PuntoSerie"
            },
            "type": "array",
            "title": "Serie"
          },
          "articulos": {
            "items": {
              "$ref": "#/components/schemas/ArticuloVenta"
            },
            "type": "array",
            "title": "Articulos"
          }
        },
        "type": "object",
        "required": [
          "meses",
          "actualizado_en",
          "serie",
          "articulos"
        ],
        "title": "AnalisisVentas"
      },
      "ArticuloVenta": {
        "properties": {
          "articulo_id": {
            "type": "integer",
            "title": "Articulo Id"
          },
          "item_code": {
            "type": "string",
            "title": "Item Code"
          },
          "descripcion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Descripcion"
          },
          "estado": {
            "$ref": "#/components/schemas/Estado"
          },
          "clase": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clase"
          },
          "unidades": {
            "type": "string",
            "title": "Unidades"
          },
          "unidades_previas": {
            "type": "string",
            "title": "Unidades Previas"
          },
          "participacion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Participacion"
          },
          "top_pct": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Top Pct"
          },
          "tendencia": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tendencia"
          },
          "abcxyz_empresa": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abcxyz Empresa"
          },
          "serie": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Serie"
          }
        },
        "type": "object",
        "required": [
          "articulo_id",
          "item_code",
          "descripcion",
          "estado",
          "clase",
          "unidades",
          "unidades_previas",
          "participacion",
          "top_pct",
          "tendencia",
          "abcxyz_empresa",
          "serie"
        ],
        "title": "ArticuloVenta"
      },
      "Atencion": {
        "properties": {
          "rechazados": {
            "type": "integer",
            "title": "Rechazados"
          },
          "verificaciones_abiertas": {
            "type": "integer",
            "title": "Verificaciones Abiertas"
          },
          "hallazgos_sap": {
            "type": "integer",
            "title": "Hallazgos Sap"
          },
          "reservados": {
            "type": "integer",
            "title": "Reservados"
          },
          "reservas_por_vencer": {
            "type": "integer",
            "title": "Reservas Por Vencer"
          }
        },
        "type": "object",
        "required": [
          "rechazados",
          "verificaciones_abiertas",
          "hallazgos_sap",
          "reservados",
          "reservas_por_vencer"
        ],
        "title": "Atencion"
      },
      "AtributoFicha": {
        "properties": {
          "paid": {
            "type": "integer",
            "title": "Paid"
          },
          "etiqueta": {
            "type": "string",
            "title": "Etiqueta"
          },
          "confirmados": {
            "type": "integer",
            "title": "Confirmados"
          },
          "sugeridos": {
            "type": "integer",
            "title": "Sugeridos"
          },
          "faltan": {
            "type": "integer",
            "title": "Faltan"
          }
        },
        "type": "object",
        "required": [
          "paid",
          "etiqueta",
          "confirmados",
          "sugeridos",
          "faltan"
        ],
        "title": "AtributoFicha"
      },
      "CambioPassword": {
        "properties": {
          "actual": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Actual"
          },
          "nueva": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Nueva"
          }
        },
        "type": "object",
        "required": [
          "actual",
          "nueva"
        ],
        "title": "CambioPassword"
      },
      "CambiosUsuario": {
        "properties": {
          "nombre": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Nombre"
          },
          "correo": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Correo"
          },
          "roles": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Rol"
                },
                "type": "array",
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Roles"
          },
          "permisos": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Permiso"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Permisos"
          },
          "activo": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Activo"
          }
        },
        "type": "object",
        "title": "CambiosUsuario"
      },
      "Categoria": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "codigo": {
            "type": "string",
            "title": "Codigo"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
